## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/
.history/

# NuGet
**/packages/*
!**/packages/build/
*.nupkg
.nuget/

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper

# DotCover
.idea/.idea.DotSettings.user

# dotenv
.env
.env.*

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Others
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
.vsconfig
*.dbmdl
*.bak
*.mdf
*.ldf
*.log
*.tgz
*.zip
*.7z

# User secrets
**/secrets.json

# EF Core
!Migrations/

# Coverage
coverage/
*.cov
*.coverage
*.coveragexml

# OS files
.DS_Store
Thumbs.db

# Publish output
publish/

# Logs
logs/
build_log*.txt
*.tmp
*.log

# Certificates
*.pfx
*.p12

# Reports
*.trx

# Rider caches
/.idea/.fleet/*
